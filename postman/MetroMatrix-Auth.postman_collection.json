{
 "info": {
  "name": "MetroMatrix — Chunk 1 (Auth + Partner Onboarding)",
  "description": "Runnable end to end, in order. Locally (docker-compose Mailpit) every code is read from Mailpit; against a server using real email, set customerVerifyToken/partnerVerifyToken/resetOtp by hand. Needs environment values baseUrl, mailpitUrl, adminEmail, adminPassword (pass it with --env-var, never commit it) and adminTotpSecret (filled on first enrolment; keep the exported environment).",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{accessToken}}",
    "type": "string"
   }
  ]
 },
 "event": [
  {
   "listen": "prerequest",
   "script": {
    "type": "text/javascript",
    "exec": [
     "// Refresh the shared session when its access token is about to expire.",
     "const exp = Number(pm.collectionVariables.get('accessTokenExpiresAt') || 0);",
     "const refresh = pm.collectionVariables.get('refreshToken');",
     "const url = pm.request.url.toString();",
     "if (refresh && exp && Date.now() > exp - 30000 && !url.includes('/auth/')) {",
     "  pm.sendRequest({",
     "    url: pm.environment.get('baseUrl') + '/auth/refresh-token',",
     "    method: 'POST',",
     "    header: { 'Content-Type': 'application/json' },",
     "    body: { mode: 'raw', raw: JSON.stringify({ refreshToken: refresh }) },",
     "  }, (err, res) => {",
     "    if (err || res.code !== 200) return;",
     "    const t = res.json().data;",
     "    pm.collectionVariables.set('accessToken', t.accessToken);",
     "    pm.collectionVariables.set('refreshToken', t.refreshToken);",
     "    pm.collectionVariables.set('accessTokenExpiresAt', Date.now() + t.expiresIn * 1000);",
     "  });",
     "}"
    ]
   }
  },
  {
   "listen": "test",
   "script": {
    "type": "text/javascript",
    "exec": [
     "// Every API response is enveloped; capture tokens from any AuthResult or refresh.",
     "if (pm.request.url.toString().includes(pm.environment.get('baseUrl'))) {",
     "  const body = pm.response.json();",
     "  pm.test('envelope', () => pm.expect(body.success).to.be.a('boolean'));",
     "  const d = body.data || {};",
     "  const t = d.tokens || (d.accessToken && d.refreshToken ? d : null);",
     "  // Only the customer flow drives the shared session; partner and admin",
     "  // requests keep their own tokens in their own variables.",
     "  const shared = pm.info.requestName.startsWith('Customer:') || pm.info.requestName === 'Sign in with the new password';",
     "  if (t && shared) {",
     "    pm.collectionVariables.set('accessToken', t.accessToken);",
     "    pm.collectionVariables.set('refreshToken', t.refreshToken);",
     "    pm.collectionVariables.set('accessTokenExpiresAt', Date.now() + t.expiresIn * 1000);",
     "  }",
     "}"
    ]
   }
  }
 ],
