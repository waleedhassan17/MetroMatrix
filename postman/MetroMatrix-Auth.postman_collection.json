      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Forgot password → 200', () => pm.response.to.have.status(200));",
         "pm.test('no enumeration', () => pm.expect(pm.response.json().data).to.eql({ delivered: true }));"
        ]
       }
      }
