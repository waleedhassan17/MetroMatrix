         "",
         "const d = pm.response.json().data;",
         "pm.test('no tokens before TOTP', () => { pm.expect(d.totpRequired).to.eql(true); pm.expect(d.tokens).to.be.undefined; });",
         "pm.collectionVariables.set('challengeToken', d.challengeToken);",
         "pm.execution.setNextRequest(d.enrolmentRequired ? 'Admin: enrol TOTP (first time)' : 'Admin: sign in (step 2, TOTP)');"
        ]
