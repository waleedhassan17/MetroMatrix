    {
     "name": "Mailpit: reset code",
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{mailpitUrl}}/api/v1/search?query={{mailpitQuery}}&limit=1",
      "auth": {
       "type": "noauth"
      },
      "description": "Local only: reads the code from Mailpit (docker-compose). Against Heroku/Brevo, read the email and set the variable by hand."
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.collectionVariables.set('mailpitQuery', encodeURIComponent('to:' + pm.collectionVariables.get('customerEmail') + ' subject:\"Your MetroMatrix password reset code\"'));"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Mailpit: reset code → 200', () => pm.response.to.have.status(200));",
         "",
         "const msg = pm.response.json().messages[0];",
         "pm.test('an email arrived', () => pm.expect(msg, 'no email yet').to.be.ok);",
         "const code = (msg.Snippet.match(/\\b(\\d{6})\\b/) || [])[1];",
         "pm.test('it carries a 6-digit code', () => pm.expect(code).to.match(/^\\d{6}$/));",
         "pm.collectionVariables.set('resetOtp', code);"
        ]
       }
      }
     ]
    },
    {
     "name": "Verify reset code",
     "request": {
      "method": "POST",
      "header": [],
      "url": {
