        "type": "text/javascript",
        "exec": [
         "pm.test('Admin: enrol TOTP (first time) → 200', () => pm.response.to.have.status(200));",
         "pm.environment.set('adminTotpSecret', pm.response.json().data.secret);"
        ]
       }
      }
     ]
    },
    {
     "name": "Admin: confirm TOTP (first time)",
     "request": {
      "method": "POST",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/admin/me/totp/confirm",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "admin",
        "me",
        "totp",
        "confirm"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"code\": \"{{totpCode}}\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{challengeToken}}",
         "type": "string"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const cryptoJs = require('crypto-js');",
         "function base32ToHex(b32) {",
         "  const a = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
         "  let bits = '';",
         "  for (const c of b32.replace(/=+$/, '').toUpperCase()) {",
         "    const v = a.indexOf(c);",
         "    if (v >= 0) bits += v.toString(2).padStart(5, '0');",
         "  }",
         "  let hex = '';",
         "  for (let i = 0; i + 8 <= bits.length; i += 8) hex += parseInt(bits.substr(i, 8), 2).toString(16).padStart(2, '0');",
         "  return hex;",
         "}",
         "function totp(secret) {",
         "  const counter = Math.floor(Date.now() / 1000 / 30).toString(16).padStart(16, '0');",
         "  const h = cryptoJs.HmacSHA1(cryptoJs.enc.Hex.parse(counter), cryptoJs.enc.Hex.parse(base32ToHex(secret))).toString(cryptoJs.enc.Hex);",
         "  const o = parseInt(h.substr(h.length - 1), 16);",
         "  return String((parseInt(h.substr(o * 2, 8), 16) & 0x7fffffff) % 1000000).padStart(6, '0');",
         "}",
         "pm.collectionVariables.set('totpCode', totp(pm.environment.get('adminTotpSecret')));"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Admin: confirm TOTP (first time) → 200', () => pm.response.to.have.status(200));",
         "",
         "const d = pm.response.json().data;",
         "pm.test('10 recovery codes', () => pm.expect(d.recoveryCodes).to.have.length(10));",
         "pm.collectionVariables.set('adminAccessToken', d.auth.tokens.accessToken);",
         "pm.execution.setNextRequest('Admin: pending businesses');"
        ]
       }
      }
     ]
    },
