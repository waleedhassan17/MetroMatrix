# MetroMatrix API — every key the app reads. No values here, ever.
# Local dev: `cp .env.example .env` and fill in (see README "Quick start").
# Heroku: set the same keys as config vars (see DEPLOYMENT.md).

# ===== App =====
NODE_ENV=
PORT=
API_PREFIX=
APP_URL=
# Comma-separated browser origins. The mobile app sends no Origin and is always allowed.
CORS_ORIGINS=

# ===== Database (DATABASE_URL, or the discrete DB_* fields) =====
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=
DB_MIGRATIONS_RUN=
# Never true outside a throwaway local database. Refused in production.
DB_SYNCHRONIZE=

# ===== Auth =====
# 32+ random chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
# Seconds a just-rotated refresh token may be presented again (0–10).
REFRESH_REUSE_GRACE_SECONDS=
# 32+ random chars, mixed into every OTP / reset / recovery-code hash.
OTP_PEPPER=
# Exactly 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENC_KEY=
BCRYPT_ROUNDS=

# ===== Mail (Brevo SMTP: smtp-relay.brevo.com:587) =====
# Empty MAIL_HOST outside production → emails (and OTPs) are logged to the console.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# ===== Google sign-in (web, android, ios client ids, comma-separated) =====
GOOGLE_CLIENT_IDS=

# ===== Cloudinary (signed direct uploads) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Push notifications (Expo) =====
# true in production once the app ships push; false sends nothing.
PUSH_ENABLED=
# Optional: Expo enhanced push security access token.
EXPO_ACCESS_TOKEN=

# ===== Healthcare video (docs/VIDEO.md) =====
# public_jitsi (default: meet.jit.si, the first participant signs in as moderator)
# or jaas (8x8 Jitsi as a Service; the three JAAS_* keys are then required).
VIDEO_PROVIDER=
# vpaas-magic-cookie-… (JaaS console → API keys).
JAAS_APP_ID=
# <JAAS_APP_ID>/<key id> of the uploaded public key.
JAAS_KID=
# The matching RSA private key, PEM; newlines may be written as \n.
JAAS_PRIVATE_KEY=

# ===== Gemini (symptom checker, kitchen AI, voice — docs/AI.md) =====
# Optional Google Gemini API key; without it every AI feature uses its manual path
# (the symptom checker falls back to its keyword matcher).
GEMINI_API_KEY=
# Symptom checker model. Default gemini-2.5-flash.
GEMINI_MODEL=
# Kitchen AI and voice model (docs/AI.md). Default gemini-3.8-flash — the model docs/VOICE.md measured.
AI_MODEL=
# Used only by `npm run voice:eval` to synthesise test clips. Default gemini-3.8-flash-tts.
GEMINI_TTS_MODEL=

# ===== Kitchen AI switches =====
# false = the kill switch: every AI feature returns its manual path / AI_UNAVAILABLE.
AI_ENABLED=
# Comma-separated features to allow (voice, menu_assistant, receipt_scan, specials,
# combos, photo_check, packing_check, review_insights, nutrition, pantry_recipes), or all.
AI_FEATURES=
# Per-request budget in ms (default 12000); slower answers fall back.
AI_TIMEOUT_MS=
# gemini (default) or google (Cloud Speech-to-Text ur-PK / en-PK; needs GOOGLE_CLOUD_API_KEY).
STT_PROVIDER=
# none (default; the app speaks on-device) or google (Cloud Text-to-Speech; needs GOOGLE_CLOUD_API_KEY).
TTS_PROVIDER=
GOOGLE_CLOUD_API_KEY=

# ===== Demo data (npm run seed:shopping) =====
# Password for the four demo store partners (demo.<store>@metromatrix.test).
SEED_DEMO_PASSWORD=

# ===== Scheduled jobs =====
# Order deadlines, reminders, completion, low-stock digests. Default true.
JOBS_ENABLED=

# ===== Ops =====
SENTRY_DSN=
SWAGGER_ENABLED=
LOG_LEVEL=
THROTTLE_TTL_SECONDS=
THROTTLE_LIMIT=

# ===== Seed only (npm run seed:superadmin) =====
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
